// =============================================================================
// idea-006 桌面工具收纳盘 —— 家里常用工具一盘子收好（参数化）
//
// 结构（一句）：一块圆角底板 + 每个工具位一圈立壁（方件用圆角矩形、圆件用圆环），
// 工具坐在底板上、被立壁围住；四周再起一道矮唇，整体像一只浅盘。
// **不是**一整块实心砖挖洞——那样 250x200 的盘子要 1.2 升料（check.py 的材料预算会拦下）。
//
// 参数化规矩（这个目录的约定）：
//   - 尺寸只写在本文件：结构参数在「参数」段，工具/槽位在两张表里
//   - 表格列固定，Python 侧（model.py / check.py）按列解析并逐条对账：
//       方槽 rect_rows : [名字, 中心x, 中心y, 工具长, 工具宽, 工具厚, 槽长, 槽宽, 槽深]
//       圆槽 bore_rows : [名字, 中心x, 中心y, 工具直径, 工具厚, 槽直径, 槽深]
//     名字只是标签（中文原样写，方便主人认），几何只看数字
//   - 槽深 = 立壁高出底板的高度；槽尺寸 = 工具尺寸 + 2*gap，check.py 逐条核对
//
// 硬约束：单件外廓 ≤250x250x250mm（主人：打印机长宽高都在 25cm 以内）
// 打印注意：只有竖直壁与水平面，没有悬垂 → 免支撑；底板 3mm 平铺不翘边
// 改动入口：只改下面「参数」与两张表，几何与派生量全跟着走。
// =============================================================================

// ---------- 参数：结构 ----------
tray_w     = 250;    // 外廓长（X）
tray_d     = 200;    // 外廓宽（Y）
tray_h     = 25;     // 总高（Z）= floor_t + 最深槽深，check.py 会对账
floor_t    = 3;      // 底板厚（槽底剩料厚度）
wall_t     = 2.6;    // 每个工具位的立壁厚（0.4 喷嘴 6 条线）
rim_h      = 8;      // 四周矮唇高度（防滚落；比最深槽矮，省料）
gap        = 0.5;    // 槽与工具的单边间隙（0.4 喷嘴起步 0.5）
corner_r   = 6;      // 外轮廓圆角
pocket_r   = 3;      // 方槽内圆角
wall_margin= 4;      // 槽到外轮廓最小距离（保证外圈有肉）

// ---------- 数据：方槽 [名字, 中心x, 中心y, 工具长, 工具宽, 工具厚, 槽长, 槽宽, 槽深] ----------
rect_rows = [
  ["剪刀",        92,  42,   175, 75, 12, 176,  76, 10],
  ["卷尺 5m",     41, 117,    65, 65, 26,  66,  66, 22],
  ["美工刀",     160, 105,   155, 35, 14, 156,  36, 12],
  ["记号笔 A",    80, 165.5, 140, 11, 11, 141,  12,  8],
  ["记号笔 B",    80, 183,   140, 11, 11, 141,  12,  8],
];

// ---------- 数据：圆槽 [名字, 中心x, 中心y, 工具直径, 工具厚, 槽直径, 槽深] ----------
bore_rows = [
  ["胶带卷",     215,  42,    60, 20, 61, 16],
];

// ---------- 几何（别动，除非要改结构） ----------
module rounded_rect(w, d, r) {
  offset(r = r) square([w - 2 * r, d - 2 * r], center = true);
}

// 底板 + 四周矮唇
module plate() {
  linear_extrude(floor_t) rounded_rect(tray_w, tray_d, corner_r);
  translate([0, 0, floor_t])
    linear_extrude(rim_h)
      difference() {
        rounded_rect(tray_w, tray_d, corner_r);
        rounded_rect(tray_w - 2 * wall_t, tray_d - 2 * wall_t, corner_r - wall_t);
      }
}

// 每个工具位一圈立壁
module wells() {
  for (row = rect_rows) {
    translate([row[1], row[2], floor_t])
      linear_extrude(row[8])
        difference() {
          rounded_rect(row[6] + 2 * wall_t, row[7] + 2 * wall_t, pocket_r + wall_t);
          rounded_rect(row[6], row[7], pocket_r);
        }
  }
  for (row = bore_rows) {
    translate([row[1], row[2], floor_t])
      linear_extrude(row[6])
        difference() {
          circle(d = row[5] + 2 * wall_t, $fn = 128);
          circle(d = row[5], $fn = 128);
        }
  }
}

// 坐标约定：表格里的中心坐标以**盘子左下角**为原点；底板/矮唇按中心对齐建，
// 所以这里整体挪到角坐标系，两套数字才对得上（包围盒由 check.py 对账）
union() {
  translate([tray_w / 2, tray_d / 2]) {
    plate();
  }
  wells();
}
