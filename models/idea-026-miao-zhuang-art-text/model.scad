// idea-026 「苗壮」艺术字 3D 牌 —— 唯一数字来源
// 本机 OpenSCAD 跑不了（x86_64 + 无 Rosetta），这个文件只当参数表；实体由 build_mesh.py
// 走 build123d 生成，厚薄/间距/底座全部从这里的数值读。
//
// 结构（两件，都免支撑）：
//   牌面：圆角矩形底板 → 正面凸起的中式边框 → 立体字；平放打印，字朝上（顶面最平整）
//   底座：带一条竖插槽，牌面插进去立起来；插槽开口朝上，槽壁竖直
// 为什么不做一体立式：牌面立起来时，立体字的每一笔横画下沿都是 100% 朝下悬垂，
// 必须全上支撑（2026-10-31 实测判据见 README）。

text_label = "苗壮";        // 字（build_mesh.py 单独解析这一行，scad_params 只吃数字）

font_size      = 70;        // 字号：一个汉字约这么高（mm）
letter_h       = 6;         // 立体字凸起高度
plate_t        = 3;         // 牌面厚度（= 插槽标称宽）
pad            = 6;         // 字到牌面边缘的留白
corner_r       = 4;         // 牌面圆角
border_w       = 2.5;       // 边框线宽
border_h       = 1.2;       // 边框凸起高度
plate_chamfer  = 0.4;       // 牌面底边倒角（贴床面，顺便给插槽让口）

base_h         = 10;        // 底座高
base_depth     = 45;        // 底座前后深度
base_side      = 3;         // 底座左右各比牌面宽
base_corner_r  = 3;         // 底座竖边圆角
base_chamfer   = 0.5;       // 底座顶边倒角
slot_clear     = 0.3;       // 插槽单边间隙（FDM 常用 0.2~0.3）
slot_depth     = 6;         // 牌面插入深度
slot_y         = -8;        // 插槽中心相对底座中心的 y（负 = 靠后，前方多留脚）

// 可打印性门槛（check.py 用）
min_stroke_mm  = 1.2;       // 笔画最细处至少 3 条 0.4 线宽
min_wall_mm    = 1.6;       // 任何结构壁厚下限
bed_max_mm     = 234;       // P1S 实测可用外廓任一边上限
max_overhang_ratio = 0.01;  // 非贴床的朝下面占比上限（>0 就是隐性支撑）
