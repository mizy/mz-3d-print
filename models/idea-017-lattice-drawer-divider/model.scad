// =============================================================================
// idea-017 镂空分隔收纳篮（苗壮制造）—— 参数段（唯一数字来源）
//
// 为什么这个文件里没有几何段：本机（macOS 27 / arm64）已无 Rosetta 2，
// ~/.cah-data/tools/OpenSCAD-2021.01.app 是 x86_64 单架构二进制，内核直接
// `Bad CPU type in executable` 拒绝执行 —— scripts/scad_build.py 调不动它。
// 实体改由同目录的 build_mesh.py 生成（skill 里另一条已文档化的离线路线：
// uv 缓存里的 cadgen + build123d / OpenCASCADE），**但每个尺寸仍只在这里写一遍**：
// build_mesh.py 通过 model.py 读这个文件，自己不写常量。
// 两个字符串参数（品牌文字、字体路径）scad_params.py 读不到（它只认 `name = 数字;`），
// 因此写在 model.py 顶部，并在这里留名：brand_text / brand_font。
//
// 结构：外壁 + 内隔板隔出 cells_x × cells_y 个格子 + 底板；墙面开圆角长孔（镂空）、
//       底板开圆孔；正面外壁留实心当品牌面，浮雕「苗壮制造」。
// 打印姿态：坐标系就是打印姿态 —— 原点在底面中心、Z 向上、正面朝 -Y；
//           全部竖直壁 + 水平底板 → 平放打印、免支撑、免桥接。
// =============================================================================

// ---------- 参数：外廓与网格 ----------
cells_x    = 3;      // 横向格数（X）
cells_y    = 2;      // 纵向格数（Y）
cell_w     = 62;     // 单格内宽（X）
cell_d     = 58;     // 单格内深（Y）
outer_h    = 60;     // 总高（含底板）
floor_t    = 2.0;    // 底板厚（开孔后的底板，2.0 = 5 圈 0.4 墙）
wall_t     = 2.0;    // 外壁厚（5 圈 0.4 墙）
divider_t  = 1.6;    // 内隔板厚（4 圈 0.4 墙）
corner_r   = 8;      // 外轮廓圆角

// ---------- 参数：镂空（竖直墙面开孔） ----------
louver_w    = 24;    // 圆角长孔的展开方向长度
louver_h    = 11;    // 孔高（Z）
louver_r    = 5;     // 孔端圆角（须 < louver_h/2；顶边平段 = louver_w - 2*louver_r ≤ 桥接上限）
louver_gap  = 9;     // 同排相邻孔之间的料（韧带）
louver_rows = 2;     // 后墙 / 左右墙每面几排
div_rows    = 1;     // 内隔板几排
band_side   = 12;    // 孔到墙面平段端头的最小料带
sill_h      = 8;     // 最下排孔下沿到 Z=0 的料带（= 孔不碰底板）
ledge_h     = 5;     // 最上排孔上沿到顶面的料带
front_solid = 1;     // 正面外壁留实心当品牌面：1 = 正面不开孔

// ---------- 参数：底板镂空 ----------
bottom_hole_d = 14;  // 底板圆孔直径
bottom_gap    = 6;   // 底板相邻孔之间的料
bottom_edge   = 8;   // 底板孔到格子内壁的最小料带

// ---------- 参数：品牌浮雕「苗壮制造」 ----------
brand_cap_h  = 9;    // 字高（Z 向）
brand_raise  = 0.8;  // 凸出墙面的高度
brand_margin = 6;    // 文字外框到墙角的最小距离
brand_z      = 30;   // 文字中心的高（Z）

// ---------- 参数：放置（不参与几何，只供自检提示） ----------
fit_clear    = 0.6;  // 建议塞进柜格时留的单边余量：柜格内径至少要 ≥ 外廓 + 2*fit_clear
