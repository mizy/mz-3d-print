// =============================================================================
// 苗白菜水印 · 印章手柄（单独一件，打好用瞬间胶粘在印章面背面正中）
//
// 为什么不和印章面做成一体：一体式手柄的圆顶朝下，FDM 上必然要支撑、底面还压不平；
// 拆成两件后手柄底盘平贴热床、往上收成截锥，**免支撑**，印章面的字面也能保持平整。
//
// 打印：底盘朝下平放，全程免支撑；0.2mm 层高、墙 3 圈足够（它只受手掌压力）。
// 粘接：手柄底盘 φ46 贴在印章面背面居中，四周留 12mm 的边，压印时手感稳。
// =============================================================================

flange_d  = 46;    // 底盘直径（粘接面）
flange_h  = 3;     // 底盘厚
grip_d1   = 30;    // 握把下端直径（比底盘小，形成外扩收腰）
grip_d2   = 38;    // 握把上端直径
grip_h    = 12;    // 握把高
dome_k    = 0.45;  // 顶部圆顶压扁系数（1 = 半球）

union() {
  cylinder(d = flange_d, h = flange_h, $fn = 96);
  translate([0, 0, flange_h])
    cylinder(d1 = grip_d1, d2 = grip_d2, h = grip_h, $fn = 96);
  translate([0, 0, flange_h + grip_h])
    difference() {
      scale([1, 1, dome_k]) sphere(d = grip_d2, $fn = 96);
      translate([-grip_d2, -grip_d2, -grip_d2]) cube([grip_d2 * 2, grip_d2 * 2, grip_d2]);
    }
}
