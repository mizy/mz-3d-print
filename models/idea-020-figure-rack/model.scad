// =============================================================================
// idea-020 桌面发带晾晒架「小人晾架」—— 参数段（唯一数字来源）
//
// 需求（主人 2026-10-25 原话）：一个二次元小人，左右手各持一根晾杆，靠小人本体当支架晾发带。
//
// 为什么这个文件里没有几何段：本机（macOS 27 / arm64）已无 Rosetta 2，
// ~/.cah-data/tools/OpenSCAD-2021.01.app 是 x86_64 单架构二进制，内核直接
// `Bad CPU type in executable` 拒绝执行 —— scripts/scad_build.py 调不动它。
// 实体改由同目录 build_mesh.py 生成（skill 里已文档化的离线路线：uv 缓存里的
// cadgen + build123d / OpenCASCADE），**但每个尺寸仍只在这里写一遍**：
// build_mesh.py 与 check.py 都通过 model.py 读这个文件，自己不写常量。
//
// 坐标系 = 打印姿态：Z 向上、底盘贴床（z=0）；X = 左右（整件左右对称），Y = 前后。
// 两根晾杆沿 Y（前后向）穿过左右两只手 —— 不是左右横伸，见 DESIGN.md §2 的力臂推算。
// 构件全是「平面多面体 / 球」：多边形截面棱柱（底盘/晾杆/拳/挡边）、圆锥台（裙摆/
// 躯干/手臂）、球（头）。用 build123d 建实体、check_model.py 复核、check.py 自检。
// =============================================================================

// ---------- 底盘（圆角矩形 94 x 104、R12；顶面开配重槽、中间留中央台站小人）----------
base_rx     = 47;   // 底盘半宽（X 左右）→ 底盘宽 = 2*base_rx = 94 ≥ 肩宽 1.2 倍 = 36
base_ry     = 52;   // 底盘半长（Y 前后）→ 底盘长 = 2*base_ry = 104（盖住两根晾杆的挂点）
base_corner_r = 12; // 底盘四角圆角半径（圆角矩形：长条轮廓的圆角会吃掉挂点内距，
                    //                 实测圆角 R47 时最外挂点只剩 3.1mm，R12 有 15mm）
base_h      = 11;   // 底盘厚（贴床那一块）
rim_w       = 4;    // 底盘最外圈实心环宽（配重槽的外壁）
groove_w    = 26;   // 配重槽净宽（沿法向）→ 能平放 Ø25 硬币
groove_d    = 5;    // 配重槽深（顶面开口；槽底 = base_h - groove_d）

// ---------- 小人（头/躯干/裙摆；头 = 球，裙摆/躯干 = 圆锥台）----------
head_r      = 20;   // 头球半径（头径 40，Q 版大头）
head_cut_z  = 55;   // 头球底部平切面高（切面埋进躯干里，不外露）
head_cut_r  = 14;   // 头球在切面处的半径（= sqrt(head_r^2-(head_cut_z-head_cz)^2)，由脚本核）
head_top_flat_r = 1.5; // 头顶平顶半径（把球极点切掉：OCC 球极点三角化会出非流形边，见 DESIGN.md §6）
torso_r_bot = 12;   // 躯干底半径
torso_r_top = 15;   // 躯干顶半径 → 肩宽 = 2*torso_r_top = 30（顶面半径必须 ≥ head_r*sin45 = 14.14 → 头球外露面免支撑）
torso_z_bot = 35;   // 躯干底高
torso_z_top = 56;   // 躯干顶高（比头球切面高 1mm；头球在躯干顶面之上的露出半径 ≥ 0.707*head_r）
hip_r_bot   = 15;   // 裙摆底半径（落在底盘中央台上）
hip_r_top   = 12;   // 裙摆顶半径（= torso_r_bot）
hip_z_bot   = 10;   // 裙摆底高（比底盘顶面低 1mm → 咬进底盘，避免共面接缝）
hip_z_top   = 38;   // 裙摆顶高（= torso_z_bot）

// ---------- 手臂（锥台，从肩到拳；抬起角 = 与竖直的夹角，必须 ≤45°）----------
arm_r_root  = 4.5;  // 手臂根部半径（肩）
arm_r_hand  = 5.5;  // 手臂末端半径（腕）
arm_root_x  = 8;    // 肩关节 |x|（根部切面必须整块埋在躯干里，否则肩上留一块朝下斜面 → check.py 卡）
arm_root_z  = 50;   // 肩关节高

// ---------- 手（环握的拳 = 绕杆的六棱柱；六棱柱边长即朝下平面宽）----------
hand_x      = 32;   // 手心 |x|（= 晾杆位置）→ 两杆间距 = 2*hand_x = 64
hand_r      = 8.5;  // 拳六棱柱外接半径（必须 > bar_r + 手指厚；上下都包住杆）
hand_len    = 15;   // 拳沿杆方向长度

// ---------- 晾杆（沿 Y 的六棱柱：平顶平底朝下，底棱宽 = bar_r）----------
bar_r       = 3.5;  // 晾杆六棱柱外接半径（杆高 1.732*bar_r = 6.06）
bar_z       = 80;   // 晾杆轴心高
bar_len     = 100;  // 晾杆长度（沿 Y 前后向）→ 半长 50，够密排 3 条（3*30=90）

// ---------- 杆端挡边（球头/挡边，防发带顺杆滑落）----------
stop_r      = 6.2;  // 挡边六棱柱外接半径（比杆粗 2.7 → 发带滑不过去）
stop_len    = 5;    // 挡边长度（每端一个，共 4 个）

// ---------- 用途与载荷（口径写在这里，几何不依赖它们）----------
band_span   = 30;   // 一条发带挂在杆上占的杆长
bands_max   = 3;    // 一根杆上最多同时挂几条（主人：同时晾 2–3 条）
wet_band_g  = 40;   // 单条湿发带重量（g，湿重上限口径）
band_com_z  = 40;   // 湿发带质心高（挂在杆上垂下来，取杆高的 ~1/2；只影响水平推力阈值）
ballast_g   = 72;   // 配重槽装满 Ø25 硬币（1 元硬币 6.1g）的估算配重，约 12 枚

// ---------- 材料密度（runtime/filament-prices.json，2026-10-24 快照）----------
rho_pla     = 1.24;  // g/cm³
rho_petg    = 1.27;  // g/cm³
