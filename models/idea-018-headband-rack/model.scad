// =============================================================================
// idea-018 桌面发带晾晒架「龙门晾架」—— 参数段（唯一数字来源）
//
// 为什么这个文件里没有几何段：本机（macOS 27 / arm64）已无 Rosetta 2，
// ~/.cah-data/tools/OpenSCAD-2021.01.app 是 x86_64 单架构二进制，内核直接
// `Bad CPU type in executable` 拒绝执行 —— scripts/scad_build.py 调不动它。
// 实体改由同目录的 build_mesh.py 生成（skill 里另一条已文档化的离线路线：
// uv 缓存里的 cadgen + build123d / OpenCASCADE），**但每个尺寸仍只在这里写一遍**：
// build_mesh.py 通过 model.py 读这个文件，自己不写常量。
//
// 结构（全部等截面棱柱 → 体积/形心/切片积分都能精确算，见 model.py）：
//   底座环 4 根（贴床）+ 立柱 6 根 + 顶面 3 根晾杆 + 2 根侧梁；一件打印、免支撑、无装配。
// 打印姿态 = 模型坐标系：Z 向上、底座环贴床（z=0）；X = 左右（整件左右对称），Y = 前后。
// 三根晾杆的 Y 位置：-bar_y_spacing / 0 / +bar_y_spacing；立柱与晾杆一一对齐。
// =============================================================================

// ---------- 玩偶安装尺寸（主人要量的两个数，见 DESIGN.md §4）----------
clear_x       = 134;   // 左右侧架内壁净宽 = 晾杆净跨（必须 > 玩偶最宽处；量到就改这里）
post_top      = 195;   // 立柱顶面高 = 整件总高（晾杆下缘 = post_top - bar_h，要压在玩偶头顶之上）

// ---------- 侧架与立柱 ----------
frame_t       = 8;     // 侧架 / 立柱在 X 方向的厚度
post_w        = 8;     // 立柱截面宽（Y）

// ---------- 底座环 ----------
base_h        = 8;     // 底环高（贴桌面那一圈）
base_w        = 8;     // 底环杆宽（水平方向）→ 外廓 Y = 2*bar_y_spacing + base_w

// ---------- 三根晾杆（沿 X）----------
bar_y_spacing = 60;    // 杆间距（Y）。湿发带厚度一般 < 15mm，60mm 足够分开、不互相压叠
bar_top_w     = 8;     // 晾杆上平面宽（发带落在这里：够宽不压折痕；上宽下窄 → 挂在杆上的圈滑不下来）
bar_bot_w     = 1.6;   // 晾杆下缘宽（唯一的桥接量：细棱跨净跨，比宽平面好打得多）
bar_h         = 7;     // 晾杆截面高

// ---------- 可选配件：挂杆小钩（一次打 4-6 个）----------
hook_x        = 24;    // 钩体沿杆长方向的长度
hook_body_t   = 3;     // 钩体板厚（坐在杆顶上那一块）
hook_flange   = 2;     // 两侧限位翼厚
hook_flange_h = 7;     // 限位翼下垂高
hook_prong_w  = 5;     // 挂钩横宽（沿杆长方向）
hook_prong_t  = 2;     // 挂钩厚
hook_prong_h  = 22;    // 挂钩下垂高
hook_fit      = 0.4;   // 与晾杆上平面的单边间隙（打印公差；卡着不掉、又能随手拿起来换位置）

// ---------- 设计假设：湿发带重量（主人量的第 3 个数；只影响受力余量，不改几何）----------
wet_band_g    = 40;    // 单条发带湿态重量（g）
wet_bands     = 3;     // 同时晾几条

// ---------- 材料密度（取自 runtime/filament-prices.json，2026-10-24 快照）----------
rho_pla       = 1.24;  // g/cm³
rho_petg      = 1.27;  // g/cm³
